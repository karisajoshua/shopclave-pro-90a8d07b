          "REST Data API"
        ],
        "summary": "Line items with vendor payout and commission snapshots",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Order items",
            "content": {
              "application/json": {
                "schema": {
