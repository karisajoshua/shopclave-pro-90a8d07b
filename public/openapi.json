        ],
        "summary": "Buyer-vendor chat threads",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Threads"
          }
        }
      }
    },
    "/rest/v1/chat_messages": {
      "post": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Send a message (Realtime-delivered)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Message sent"
          }
        }
      }
    },
    "/rest/v1/notifications": {
      "get": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Realtime notifications (orders, messages)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notifications"
          }
        }
      }
    },
    "/rest/v1/vendor_ledger": {
      "get": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Vendor earnings ledger (platform-collected funds)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ledger entries in CAD",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LedgerEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/vendor_paystack_accounts": {
      "get": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Vendor Paystack payout account status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Paystack account rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaystackAccount"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/rpc/get_product_ratings": {
      "post": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Aggregated product rating averages",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "product_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rating aggregates"
          }
        }
      }
    },
    "/functions/v1/create-order": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create an order",
        "description": "Creates the order and order_items, computes per-vendor commission\nand payout snapshots, stores currency as CAD, and sends order\nconfirmation emails to the buyer and every affected vendor.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/functions/v1/get-shipping-rates": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Get shipping rates for a delivery address",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "country"
                ],
                "properties": {
                  "country": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Available shipping options"
          }
        }
      }
    },
    "/functions/v1/paystack-initialize": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Initialize a Paystack transaction for an order",
        "description": "Recomputes the order total server-side from order_items, converts\nCAD → buyer's local currency (NGN/GHS/ZAR/KES/EGP/XOF, USD elsewhere),\nand builds a per-vendor flat split for connected Paystack subaccounts.\nReturns the Paystack authorization URL to redirect the buyer to.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "order_id"
                ],
                "properties": {
                  "order_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "return_path": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction initialized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaystackInitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Order already paid / invalid"
          },
          "403": {
            "description": "Not the order owner"
          }
        }
      }
    },
    "/functions/v1/paystack-verify": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Verify a transaction by reference (order confirmation page)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction status from Paystack"
          }
        }
      }
    },
    "/functions/v1/paystack-webhook": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Paystack webhook receiver (server-to-server)",
        "description": "HMAC-SHA512 signature verified via `x-paystack-signature`.\nHandles `charge.success` (marks order paid, records split codes,\ncredits vendor ledger for platform-collected shares) and\n`charge.failed`.\n",
        "parameters": [
          {
            "name": "x-paystack-signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaystackEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event received"
          },
          "400": {
            "description": "Missing/invalid signature"
          }
        }
      }
    },
    "/functions/v1/paystack-banks": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "List banks for a country (vendor payout setup)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "nigeria",
                "ghana",
                "south africa",
                "kenya",
                "egypt",
                "cote d'ivoire"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bank list from Paystack"
          }
        }
      }
    },
    "/functions/v1/paystack-subaccount": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create/update a vendor Paystack subaccount",
        "description": "Resolves the bank account holder name via Paystack, then creates or\nupdates the vendor's subaccount so order payments split directly to\ntheir bank.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubaccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subaccount connected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaystackAccount"
                }
              }
            }
          },
          "404": {
            "description": "Vendor profile not found"
          }
        }
      }
    },
    "/functions/v1/send-transactional-email": {
      "post": {
        "tags": [
          "Emails"
        ],
        "summary": "Send a transactional email (order confirmation, vendor new order)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "template",
                  "to",
                  "data"
                ],
                "properties": {
                  "template": {
                    "type": "string",
                    "enum": [
                      "order-confirmation",
                      "vendor-new-order"
                    ]
                  },
                  "to": {
                    "type": "string",
                    "format": "email"
                  },
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email queued/sent"
          }
        }
      }
    },
    "/functions/v1/process-email-queue": {
      "post": {
        "tags": [
          "Emails"
        ],
        "summary": "Process the queued email backlog (scheduled/invoked)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Queue processed"
          }
        }
      }
    },
    "/functions/v1/auth-email-hook": {
      "post": {
        "tags": [
          "Emails"
        ],
        "summary": "Auth hook — renders branded signup/recovery/magic-link emails",
        "description": "Internal hook called by the auth system (not for public use).",
        "responses": {
          "200": {
            "description": "Rendered email returned"
          }
        }
      }
    },
    "/functions/v1/handle-email-unsubscribe": {
      "get": {
        "tags": [
          "Emails"
        ],
        "summary": "One-click unsubscribe endpoint",
        "responses": {
          "200": {
            "description": "Unsubscribed"
          }
