  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "User access token from the Auth API"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Select": {
        "name": "select",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "PostgREST column/embedding selector, e.g. `*,vendor:vendors(store_name)`"
      }
    },
    "schemas": {
      "Session": {
