{
  "openapi": "3.0.3",
  "info": {
    "title": "Barakaz API",
    "description": "OpenAPI specification for the Barakaz multivendor marketplace.\n\nBarakaz is a Canadian-based global marketplace connecting buyers directly\nwith independent vendors. The backend is powered by Lovable Cloud\n(PostgreSQL + Edge Functions + Auth + Storage).\n\n## Architecture\n- **REST Data API** — auto-generated PostgREST endpoints for all tables\n  (row-level security enforced per role: Admin, Vendor, Customer).\n- **Edge Functions** — custom business logic (orders, payments, emails,\n  geolocation, sitemap, analytics, social).\n- **Auth** — email/password and Google OAuth via the Auth API.\n\n## Conventions\n- All product prices are stored in **CAD** and converted at display/charge\n  time based on the buyer's country.\n- Payments are processed via Paystack with per-vendor split settlements.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Barakaz",
      "url": "https://www.barakaz.com"
    }
  },
  "servers": [
    {
      "url": "https://fyfeyolecqnpriwjgzyo.supabase.co",
      "description": "Production (Lovable Cloud)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and user sessions"
    },
    {
      "name": "REST Data API",
      "description": "PostgREST table endpoints (RLS enforced)"
    },
    {
      "name": "Orders",
      "description": "Order creation and lifecycle"
    },
    {
      "name": "Payments",
      "description": "Paystack payment processing and vendor payouts"
    },
    {
      "name": "Emails",
      "description": "Transactional email pipeline"
    },
    {
      "name": "Utilities",
      "description": "Geolocation, sitemap, analytics, social"
    }
  ],
  "paths": {
    "/auth/v1/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user (email + password)",
        "description": "Email confirmation is required before sign-in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  },
                  "data": {
                    "type": "object",
                    "description": "User metadata (full_name, role)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created",
            "confirmation email sent": null
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/auth/v1/token?grant_type=password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with email and password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/v1/authorize?provider=google": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Start Google OAuth flow",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "google"
              ]
            }
          },
          {
            "name": "redirect_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Google consent screen"
          }
        }
      }
    },
    "/auth/v1/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out (revoke refresh token)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/rest/v1/products": {
      "get": {
        "tags": [
          "REST Data API"
        ],
        "summary": "List/search products",
        "parameters": [
          {
            "$ref": "#/components/parameters/Select"
          },
          {
            "name": "category_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "vendor_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "draft",
                "archived"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "e.g. created_at.desc"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product rows (prices in CAD)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Create a product (vendor)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/rest/v1/products/{id}": {
      "patch": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Update a product (owner vendor or admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Delete a product",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/rest/v1/categories": {
      "get": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Browse the 5-level category taxonomy",
        "parameters": [
          {
            "name": "parent_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid",
              "nullable": true
            }
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/vendors": {
      "get": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Public vendor/store directory",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "suspended"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vendor rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Vendor"
                  }
                }
