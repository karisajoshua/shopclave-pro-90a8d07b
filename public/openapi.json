    "/rest/v1/cart_items": {
      "get": {
        "tags": [
          "REST Data API"
        ],
        "summary": "Server-side cart for signed-in users",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cart items"
          }
